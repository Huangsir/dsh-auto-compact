{
  "name": "dsh-auto-compact",
  "version": "2.0.3",
  "description": "会话级自动上下文压缩插件：回合中每步前 + 回合结束检测上下文用量，超过会话阈值自动 compact，摘要注入上下文后自然继续（DeepSeek Harness / DSH）",
  "type": "module",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "main": "lib/index.js",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check:compat": "node scripts/check-compat.mjs"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "docs",
    "README.zh.md"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "compaction",
    "context",
    "dsh-auto-compact",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Huangsir/dsh-auto-compact.git"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis-plugin-timer": "^1.1.3",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.6 <0.3.0-0",
    "@deepseek-ai/dsh-agent-presets": ">=0.1.0-rc.6 <0.3.0-0",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.0-rc.6 <0.3.0-0",
    "@deepseek-ai/dsh-client-connection": ">=0.1.0-rc.6 <0.3.0-0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.0-rc.6 <0.3.0-0",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.6 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.0-rc.6 <0.3.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.6 <0.3.0-0",
    "@deepseek-ai/dsh-session-projection": ">=0.1.0-rc.6 <0.3.0-0",
    "@deepseek-ai/dsh-token-meter": ">=0.1.0-rc.6 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-session-query": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-agent-default-model": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-settings": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-session-query": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-store": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.1-alpha.2",
    "clsx": "^2.1.1",
    "immer": "^11.1.21",
    "jsdom": "^30.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.15"
  }
}
